{
    "name":"jobfinder",
    "app":{
        "cfengine":"lucee@6"
    },
    "profile":"development",
    "web":{
        "host":"0.0.0.0",
        "webroot":"wwwroot",
        "http":{
            "port":8888,
            "enable":true
        },
        "ajp":{
            "enable":false
        },
        "blockCFAdmin":false
    },
    "jvm":{
        "heapSize":"256",
        "minHeapSize":"128",
        "args":"--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED"
    }
}
