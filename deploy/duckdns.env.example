# Copy to: duckdns.env   (then: chmod 600 duckdns.env)
# This file holds a secret — it is gitignored. Never commit the real one.
#
# DUCKDNS_DOMAIN = just the label you registered, WITHOUT ".duckdns.org"
#                  e.g. if your host is cfobserver.duckdns.org -> cfobserver
# DUCKDNS_TOKEN  = the UUID token shown at the top of your DuckDNS dashboard
DUCKDNS_DOMAIN=YOUR_SUBDOMAIN
DUCKDNS_TOKEN=YOUR_DUCKDNS_TOKEN
