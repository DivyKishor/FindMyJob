# SQLite database (local)
wwwroot/data/*.db
wwwroot/data/*.db-*
coldfusion_intel.db
*.db-shm
*.db-wal

# Local agent / IDE session settings
.claude/

# Real config with secrets (use app.example.json as the template)
wwwroot/config/app.json

# DuckDNS token (use deploy/duckdns.env.example as the template)
deploy/duckdns.env

# Test runtime artifacts
tests/results/
.testbox/

# CommandBox / TestBox install + server artifacts
testbox/
.engine/
.commandbox/
server-*.json.bak

# Logs
wwwroot/logs/*.log

# Large JARs (downloaded at deploy/startup time)
wwwroot/lib/*.jar

# ColdFusion server artifacts
**/WEB-INF/

# Local Lucee Express runtime (downloaded by scripts/start-lucee.sh)
.runtime/

# OS / IDE
.DS_Store
.idea/
.vscode/
